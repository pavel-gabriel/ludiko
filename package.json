  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node scripts/check-bundle-size.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "rules:check": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore,database --project demo-ludiko \"echo rules OK\"",
    "rules:test": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore,database --project demo-ludiko \"node tests/rules/emulator-rules.mjs\""
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/opendyslexic": "^5.2.5",
    "firebase": "^11.3.0",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^7.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.7.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.5",
    "web-push": "^4.0.0"
