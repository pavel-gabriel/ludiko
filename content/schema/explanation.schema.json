{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ludiko/content/schema/explanation.schema.json",
  "title": "Explanation",
  "description": "Illustrated frames shown on a mistake (docs/PLAN.md section 5.4). Mirrors Explanation in src/engine/types.ts.",
  "type": "object",
  "required": ["id", "title", "frames", "reviewStatus", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "skillId": { "type": "string", "minLength": 1 },
    "title": { "$ref": "#/$defs/localizedText" },
    "frames": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/frame" } },
    "reviewStatus": { "enum": ["auto-checked", "beta", "reviewed"] },
    "provenance": { "$ref": "provenance.schema.json" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["ro"],
      "additionalProperties": false,
      "properties": {
        "ro": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      }
    },
    "mediaRef": {
      "type": "object",
      "required": ["kind", "src", "alt"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["image", "audio"] },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "$ref": "#/$defs/localizedText" },
        "provenanceId": { "type": "string", "minLength": 1 }
      }
    },
    "frame": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/localizedText" },
        "visual": { "$ref": "#/$defs/visualSpec" },
        "audio": { "$ref": "#/$defs/mediaRef" }
      }
    },
    "visualSpec": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "from", "to"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "number-line" },
            "from": { "type": "number" },
            "to": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "marks": { "type": "array", "items": { "type": "number" } },
            "jumps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to"],
                "additionalProperties": false,
                "properties": { "from": { "type": "number" }, "to": { "type": "number" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "base10-blocks" },
            "hundreds": { "type": "integer", "minimum": 0 },
            "tens": { "type": "integer", "minimum": 0 },
            "ones": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "hours", "minutes"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "clock" },
            "hours": { "type": "integer", "minimum": 0, "maximum": 23 },
            "minutes": { "type": "integer", "minimum": 0, "maximum": 59 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "amounts"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "money" },
            "amounts": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
          }
        },
        {
          "type": "object",
          "required": ["kind", "icon", "count"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "objects" },
            "icon": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 0 },
            "groups": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "numerator", "denominator"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "fraction" },
            "numerator": { "type": "integer", "minimum": 0 },
            "denominator": { "type": "integer", "minimum": 1 },
            "shape": { "enum": ["circle", "bar"] }
          }
        },
        {
          "type": "object",
          "required": ["kind", "media"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "image" },
            "media": { "$ref": "#/$defs/mediaRef" }
          }
        }
      ]
    }
  }
}
