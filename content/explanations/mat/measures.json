  {
    "id": "exp.clock.quarter",
    "skillId": "mat.clock.quarter",
    "title": {
      "ro": "Ora și un sfert, ora fără un sfert",
      "en": "Quarter past and quarter to"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "Un sfert de oră înseamnă 15 minute. Limba mare arată spre 3: ora 3 și un sfert.",
          "en": "A quarter of an hour is 15 minutes. The long hand points to 3: quarter past 3."
        },
        "visual": {
          "kind": "clock",
          "hours": 3,
          "minutes": 15
        }
      },
      {
        "text": {
          "ro": "La jumătate, limba mare arată spre 6: ora 3 și jumătate.",
          "en": "At half past, the long hand points to 6."
        },
        "visual": {
          "kind": "clock",
          "hours": 3,
          "minutes": 30
        }
      },
      {
        "text": {
          "ro": "După 45 de minute limba mare arată spre 9. Mai lipsește un sfert până la ora 4: ora 4 fără un sfert.",
          "en": "After 45 minutes the long hand points to 9. A quarter is missing until 4: quarter to 4."
        },
        "visual": {
          "kind": "clock",
          "hours": 3,
          "minutes": 45
        }
      },
      {
        "text": {
          "ro": "Se scrie 3:45. Peste un sfert de oră va fi ora 4.",
          "en": "We write 3:45. In a quarter of an hour it will be 4 o'clock."
        },
        "visual": {
          "kind": "clock",
          "hours": 4,
          "minutes": 0
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.clock.quarter",
