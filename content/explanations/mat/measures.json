  {
    "id": "exp.time.calendar",
    "skillId": "mat.time.calendar",
    "title": {
      "ro": "Zilele, lunile și anul",
      "en": "Days, months and the year"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "O săptămână are 7 zile: luni, marți, miercuri, joi, vineri, sâmbătă, duminică.",
          "en": "A week has 7 days: Monday to Sunday."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 7,
          "step": 1,
          "marks": [
            7
          ]
        }
      },
      {
        "text": {
          "ro": "Două săptămâni au 14 zile: 7 + 7 = 14.",
          "en": "Two weeks have 14 days: 7 + 7 = 14."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 14,
          "step": 1,
          "marks": [
            7,
            14
          ],
          "jumps": [
            {
              "from": 0,
              "to": 7
            },
            {
              "from": 7,
              "to": 14
            }
          ]
        }
      },
      {
        "text": {
          "ro": "Un an are 12 luni: ianuarie, februarie, martie… până la decembrie.",
          "en": "A year has 12 months: January, February, March… up to December."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 12,
          "step": 1,
          "marks": [
            12
          ]
        }
      },
      {
        "text": {
          "ro": "Un an are 12 luni, deci doi ani au 24 de luni.",
          "en": "A year has 12 months, so two years have 24 months."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 24,
          "step": 2,
          "marks": [
            12,
            24
          ],
          "jumps": [
            {
              "from": 0,
              "to": 12
            },
            {
              "from": 12,
              "to": 24
            }
          ]
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.time.calendar",
      "kind": "explanation",
      "title": "Days, months and the year",
      "author": "Ludiko",
      "source": "ai-draft",
