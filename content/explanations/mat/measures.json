  {
    "id": "exp.time.hm",
    "skillId": "mat.time.hm",
    "title": {
      "ro": "O oră are 60 de minute",
      "en": "An hour has 60 minutes"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "Limba mare face un tur întreg al ceasului în 60 de minute. Deci 1 oră = 60 de minute.",
          "en": "The long hand goes once around the clock in 60 minutes. So 1 hour = 60 minutes."
        },
        "visual": {
          "kind": "clock",
          "hours": 5,
          "minutes": 0
        }
      },
      {
        "text": {
          "ro": "Jumătate de oră are 30 de minute, iar un sfert de oră are 15 minute.",
          "en": "Half an hour is 30 minutes and a quarter of an hour is 15 minutes."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 60,
          "step": 15,
          "marks": [
            15,
            30,
            60
          ]
        }
      },
      {
        "text": {
          "ro": "2 ore = 60 + 60 = 120 de minute.",
          "en": "2 hours = 60 + 60 = 120 minutes."
        },
        "visual": {
          "kind": "number-line",
          "from": 0,
          "to": 120,
          "step": 20,
          "marks": [
            60,
            120
          ],
          "jumps": [
            {
              "from": 0,
              "to": 60
            },
            {
              "from": 60,
              "to": 120
            }
          ]
        }
      },
      {
        "text": {
          "ro": "De la ora 3 la ora 7 sunt 4 ore: numărăm 4 sărituri pe ceas.",
          "en": "From 3 o'clock to 7 o'clock is 4 hours: count 4 steps around the clock."
        },
        "visual": {
          "kind": "number-line",
          "from": 3,
          "to": 7,
          "step": 1,
          "marks": [
            3,
            7
          ],
          "jumps": [
            {
              "from": 3,
              "to": 7
            }
          ]
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.time.hm",
      "kind": "explanation",
      "title": "An hour has 60 minutes",
      "author": "Ludiko",
      "source": "ai-draft",
      "licence": "OWN",
      "notes": "original explanation; awaiting human review"
    }
