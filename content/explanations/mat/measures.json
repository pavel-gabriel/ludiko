  {
    "id": "exp.clock.minutes",
    "skillId": "mat.clock.minutes",
    "title": {
      "ro": "Citim minutele pe ceas",
      "en": "Reading minutes on the clock"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "Între două numere ale ceasului trec 5 minute. Limba mare arată spre 4: 4 × 5 = 20 de minute.",
          "en": "Between two numbers on the clock, 5 minutes pass. The long hand points to 4: 4 × 5 = 20 minutes."
        },
        "visual": {
          "kind": "clock",
          "hours": 2,
          "minutes": 20
        }
      },
      {
        "text": {
          "ro": "Limba mică e între 2 și 3. Este ora 2 și 20 de minute (2:20).",
          "en": "The short hand is between 2 and 3. It is 20 minutes past 2 (2:20)."
        },
        "visual": {
          "kind": "clock",
          "hours": 2,
          "minutes": 20
        }
      },
      {
        "text": {
          "ro": "Peste 30 de minute: 20 + 30 = 50. Ceasul arată 2:50.",
          "en": "In 30 minutes: 20 + 30 = 50. The clock shows 2:50."
        },
        "visual": {
          "kind": "clock",
          "hours": 2,
          "minutes": 50
        }
      },
      {
        "text": {
          "ro": "Cu 50 de minute trecute, mai lipsesc 10 minute până la ora 3: ora 3 fără 10 minute.",
          "en": "With 50 minutes gone, 10 minutes are missing until 3: 10 to 3."
        },
        "visual": {
          "kind": "clock",
          "hours": 2,
          "minutes": 50
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.clock.minutes",
