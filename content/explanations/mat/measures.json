  {
    "id": "exp.clock.hour",
    "skillId": "mat.clock.hour",
    "title": {
      "ro": "Ceasul arată ora fixă",
      "en": "The clock shows a full hour"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "Ceasul are două limbi. Limba mică arată orele, iar limba mare arată minutele.",
          "en": "A clock has two hands. The short hand shows the hours and the long hand shows the minutes."
        },
        "visual": {
          "kind": "clock",
          "hours": 3,
          "minutes": 0
        }
      },
      {
        "text": {
          "ro": "Când limba mare arată spre 12, este o oră fixă.",
          "en": "When the long hand points to 12, it is a full hour."
        },
        "visual": {
          "kind": "clock",
          "hours": 6,
          "minutes": 0
        }
      },
      {
        "text": {
          "ro": "Limba mică arată spre 6, deci este ora 6. Scriem 6:00.",
          "en": "The short hand points to 6, so it is 6 o'clock. We write 6:00."
        },
        "visual": {
          "kind": "clock",
          "hours": 6,
          "minutes": 0
        }
      },
      {
        "text": {
          "ro": "Încearcă singur: aici limba mică arată spre 9, deci este ora 9.",
          "en": "Try it yourself: here the short hand points to 9, so it is 9 o'clock."
        },
        "visual": {
          "kind": "clock",
          "hours": 9,
          "minutes": 0
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.clock.hour",
      "kind": "explanation",
      "title": "The clock shows a full hour",
      "author": "Ludiko",
      "source": "ai-draft",
      "licence": "OWN",
      "notes": "original explanation; awaiting human review"
    }
  },
  {
    "id": "exp.clock.half",
    "skillId": "mat.clock.half",
    "title": {
      "ro": "Ora și jumătate",
      "en": "Half past the hour"
    },
    "reviewStatus": "beta",
    "frames": [
      {
        "text": {
          "ro": "La ora 4 limba mare arată spre 12.",
          "en": "At 4 o'clock the long hand points to 12."
        },
        "visual": {
          "kind": "clock",
          "hours": 4,
          "minutes": 0
        }
      },
      {
        "text": {
          "ro": "După jumătate de oră, limba mare a ajuns spre 6. Au trecut 30 de minute.",
          "en": "After half an hour the long hand has reached 6. 30 minutes have passed."
        },
        "visual": {
          "kind": "clock",
          "hours": 4,
          "minutes": 30
        }
      },
      {
        "text": {
          "ro": "Limba mică este între 4 și 5. Spunem: ora 4 și jumătate.",
          "en": "The short hand is between 4 and 5. We say: half past 4."
        },
        "visual": {
          "kind": "clock",
          "hours": 4,
          "minutes": 30
        }
      },
      {
        "text": {
          "ro": "Se scrie 4:30. Peste încă 30 de minute va fi ora 5.",
          "en": "We write 4:30. In another 30 minutes it will be 5 o'clock."
        },
        "visual": {
          "kind": "clock",
          "hours": 5,
          "minutes": 0
        }
      }
    ],
    "provenance": {
      "id": "prov.exp.clock.half",
      "kind": "explanation",
      "title": "Half past the hour",
      "author": "Ludiko",
      "source": "ai-draft",
