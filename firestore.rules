rules_version = '2';

// Firestore rules for Ludiko — Phase 1c (Classroom / Teacher Mode)
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // ===== ADMIN AUTH (begin) =====
    // Admin identity: a document admins/{uid} created manually in the Firebase console.
    // Clients can never write it; a signed-in user may read ONLY their own doc (the
    // UI uses that to check admin status). Anonymous sessions are never admins.
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // ===== ADMIN AUTH (end) =====

    // Game history: REMOVED (privacy finding F1). The cloud leaderboard stored names typed by children
    // forever. No client reads or writes it any more; existing documents are removed with
    // scripts/privacy/delete-game-history.mjs (firebase-admin bypasses these rules).
    match /gameHistory/{docId} {
      allow read, write: if false;
    }

    // Teacher profiles: teachers can read/write their own profile.
    // `list` is admin-only (the admin dashboard counts teachers); get of
    // individual docs stays owner-only.
    match /teachers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ===== BEGIN v1 teacher sessions (docs/PRIVACY_DATA_MAP.md F3) =====
    // sessions/{id}              the teacher's session: title, settings, studentCodes[{code,label}] (labels may be
    //                            real names chosen by the teacher). Readable ONLY by the teacher who owns it.
    // sessionCodes/{sessionId}_{CODE}   exact-key index a student's device reads (get, never list) to check the code
    //                            it was given. Holds no label and no name.
    // sessionResults/{sessionId} the teacher's saved results. Only that teacher reads or writes it.
    // sessionResults/{sessionId}_{CODE}  a student's own result, keyed by the code, written by the student's
    //                            device (create/update only, strict fields); never readable by students.
    function isSessionTeacher(sessionId) {
      return request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.teacherUid == request.auth.uid;
    }

    match /sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    match /sessionCodes/{codeKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.auth.token.firebase.sign_in_provider != 'anonymous'
                            && request.resource.data.keys().hasOnly(['sessionId', 'teacherUid', 'code'])
                            && request.resource.data.keys().hasAll(['sessionId', 'teacherUid', 'code'])
                            && request.resource.data.teacherUid == request.auth.uid
                            && request.resource.data.sessionId is string
                            && request.resource.data.code is string
                            && request.resource.data.code.size() >= 1
                            && request.resource.data.code.size() <= 20
                            && codeKey == request.resource.data.sessionId + '_' + request.resource.data.code
                            && isSessionTeacher(request.resource.data.sessionId);
      allow delete: if request.auth != null
                    && (resource == null || resource.data.teacherUid == request.auth.uid);
    }

    // Teacher document: id == sessionId. Student document: id == "{sessionId}_{CODE}" (session ids never contain "_").
    match /sessionResults/{resultId} {
      function resultSession() {
        return resultId.split('_')[0];
      }

      function validTeacherResults(d) {
        return d.keys().hasOnly(['results', 'savedAt'])
            && d.results is list
            && d.results.size() <= 300
            && d.savedAt is number;
      }

      function validStudentResult(d) {
        return d.keys().hasAll(['studentCode', 'score', 'totalQuestions', 'updatedAt'])
            && d.keys().hasOnly(['studentCode', 'score', 'totalQuestions', 'accuracy', 'timeTaken', 'updatedAt'])
            && d.studentCode is string && d.studentCode.size() >= 1 && d.studentCode.size() <= 20
            && resultId == resultSession() + '_' + d.studentCode
            && d.score is int && d.score >= 0 && d.score <= 1000
            && d.totalQuestions is int && d.totalQuestions >= 0 && d.totalQuestions <= 1000
            && (!('accuracy' in d) || (d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100))
            && (!('timeTaken' in d) || (d.timeTaken is number && d.timeTaken >= 0 && d.timeTaken <= 86400))
            && d.updatedAt is number;
      }

      // Only the session's teacher ever reads results (students cannot read their own or anyone else's).
      allow read: if isSessionTeacher(resultSession());
      allow create, update: if (!resultId.matches('.*_.*')
                                && isSessionTeacher(resultId)
                                && validTeacherResults(request.resource.data))
                            // a student's device writes ONLY the document of a code that exists in the index
                            || (request.auth != null
                                && resultId.matches('^[A-Za-z0-9]+_[A-Za-z0-9-]+$')
                                && validStudentResult(request.resource.data)
                                && exists(/databases/$(database)/documents/sessionCodes/$(resultId)));
      allow delete: if isSessionTeacher(resultSession());
    }
    // ===== END v1 teacher sessions =====

    // Content reports ("Raportează o greșeală"). Anyone with an anonymous
    // session may create a report, but only with the allowed fields and
    // status 'open'. Reads and status updates are admin-only (isAdmin()).
    // Deletes are denied.
    match /contentReports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['itemId', 'skillId', 'reason', 'comment', 'createdAt', 'status', 'appVersion', 'snapshot'])
                    && request.resource.data.keys().hasAll(
                         ['itemId', 'reason', 'createdAt', 'status'])
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() > 0
                    && request.resource.data.itemId.size() <= 100
                    && request.resource.data.reason in
                         ['wrong-answer', 'unclear', 'typo', 'inappropriate', 'rights']
                    && request.resource.data.createdAt is number
                    && request.resource.data.status == 'open'
                    && (!('skillId' in request.resource.data)
                        || (request.resource.data.skillId is string
                            && request.resource.data.skillId.size() <= 100))
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 300))
                    && (!('appVersion' in request.resource.data)
                        || (request.resource.data.appVersion is string
                            && request.resource.data.appVersion.size() <= 20))
                    // Snapshot of the item as the child saw it (no personal data, never the child's answer).
                    && (!('snapshot' in request.resource.data)
                        || (request.resource.data.snapshot is map
                            && request.resource.data.snapshot.keys().hasOnly(
                                 ['type', 'prompt', 'options', 'correct', 'visualKind',
                                  'skillId', 'subject', 'grade', 'context', 'route'])
                            && request.resource.data.snapshot.keys().hasAll(
                                 ['type', 'prompt', 'correct', 'skillId', 'subject', 'grade', 'context', 'route'])
                            && request.resource.data.snapshot.type is string
                            && request.resource.data.snapshot.type.size() <= 40
                            && request.resource.data.snapshot.prompt is string
                            && request.resource.data.snapshot.prompt.size() <= 500
                            && request.resource.data.snapshot.correct is string
                            && request.resource.data.snapshot.correct.size() <= 200
                            && request.resource.data.snapshot.skillId is string
                            && request.resource.data.snapshot.skillId.size() <= 100
                            && request.resource.data.snapshot.subject in
                                 ['mat', 'rom', 'stiinte', 'ist', 'geo', 'civ', 'logic', 'bio', 'fiz', 'chim']
                            && request.resource.data.snapshot.grade is number
                            && request.resource.data.snapshot.grade >= 0
                            && request.resource.data.snapshot.grade <= 8
                            && request.resource.data.snapshot.context in
                                 ['practice', 'bit', 'mission', 'exam', 'game', 'placement']
                            && request.resource.data.snapshot.route is string
                            && request.resource.data.snapshot.route.size() <= 100
                            && (!('visualKind' in request.resource.data.snapshot)
                                || (request.resource.data.snapshot.visualKind is string
                                    && request.resource.data.snapshot.visualKind.size() <= 40))
                            && (!('options' in request.resource.data.snapshot)
                                || (request.resource.data.snapshot.options is list
                                    && request.resource.data.snapshot.options.size() <= 10))));
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['open', 'resolved', 'dismissed'];
    }

    // Push reminder subscriptions (docs/NOTIFICATIONS.md §3). One document per device, id = sha-256
    // hex of the endpoint. No personal data. Clients (anonymous auth) may create/update/delete but
    // never read or list: the sender reads with the Admin SDK, which bypasses these rules, and is
    // the only writer of `lastSentDay` (clients may only keep it unchanged, which lets them update
    // a document the sender has already touched).
    match /pushSubscriptions/{subId} {
      function validPushFields(d) {
        return d.keys().hasAll(['endpoint', 'keys', 'hour', 'timezone', 'lang', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['endpoint', 'keys', 'hour', 'timezone', 'lang', 'active',
                               'lastPlayedDay', 'lastSentDay', 'createdAt', 'updatedAt'])
          && d.endpoint is string
          && d.endpoint.size() <= 1024
          && d.endpoint.matches('^https://.+')
          && d['keys'] is map
          && d['keys'].keys().hasOnly(['p256dh', 'auth'])
          && d['keys'].keys().hasAll(['p256dh', 'auth'])
          && d['keys'].p256dh is string && d['keys'].p256dh.size() > 0 && d['keys'].p256dh.size() <= 256
          && d['keys'].auth is string && d['keys'].auth.size() > 0 && d['keys'].auth.size() <= 64
          && d.hour is int && d.hour >= 8 && d.hour <= 20
          && d.timezone is string && d.timezone.size() > 0 && d.timezone.size() <= 64
          && d.lang in ['ro', 'en']
          && d.active is bool
          && (!('lastPlayedDay' in d)
              || (d.lastPlayedDay is string && d.lastPlayedDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.createdAt is number
          && d.updatedAt is number;
      }

      allow read: if false;
      allow create: if request.auth != null
                    && subId.matches('^[0-9a-f]{64}$')
                    && validPushFields(request.resource.data)
                    && !('lastSentDay' in request.resource.data);
      allow update: if request.auth != null
                    && validPushFields(request.resource.data)
                    && request.resource.data.get('lastSentDay', null) == resource.data.get('lastSentDay', null);
      allow delete: if request.auth != null;
    }

    // Templates (legacy): the app no longer creates them (a session is repeated from a past session instead).
    // The owner teacher can still list and delete the old documents (also done by account deletion).
    match /templates/{templateId} {
      allow read: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;
    }

    // ===== BEGIN Classroom (docs/CLASSROOM.md §2-§3): classes, seats, progress, assignments, joinCodes =====
    //
    // Seat-join approach: seat id == join code (6 chars, globally unique). A device that knows a code
    //  1. reads `joinCodes/{code}` (get only, `list` is denied, so codes cannot be enumerated) to learn
    //     the classId and class name, then
    //  2. flips its seat once from linked=false to linked=true (nothing else may change), and
    //  3. may then write `classes/{classId}/progress/{code}` while that seat is linked.
    // Possession of the code is the capability; a teacher "unlink" deletes the seat and issues a new code.
    // Known limits (rules cannot loop): values inside `subjects.*.skills` are checked as a set, not per key,
    // and skillIds elements of an assignment are not type-checked individually.

    function isTeacherOf(classId) {
      return request.auth != null
          && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    function validJoinCode(code) {
      return code.matches('^[A-HJKMNP-Z2-9]{6}$');
    }

    match /classes/{classId} {
      function validClass(d) {
        return d.keys().hasAll(['teacherUid', 'name', 'grade', 'createdAt'])
            && d.keys().hasOnly(['teacherUid', 'name', 'grade', 'createdAt'])
            && d.teacherUid is string
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
            && d.grade is int && d.grade >= 0 && d.grade <= 8
            && d.createdAt is number;
      }

      // Only the teacher sees the class document; children get the class name from joinCodes/{code}.
      allow get: if request.auth != null
                 && (resource == null || resource.data.teacherUid == request.auth.uid);
      allow list: if request.auth != null && resource.data.teacherUid == request.auth.uid;
      // Real (non-anonymous) accounts only: a child's anonymous session cannot create classes.
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.teacherUid == request.auth.uid
                    && validClass(request.resource.data);
      allow update: if request.auth != null
                    && resource.data.teacherUid == request.auth.uid
                    && request.resource.data.teacherUid == resource.data.teacherUid
                    && validClass(request.resource.data);
      allow delete: if request.auth != null && resource.data.teacherUid == request.auth.uid;

      match /seats/{seatId} {
        function validSeat(d) {
          return d.keys().hasAll(['label', 'joinCode', 'linked'])
              && d.keys().hasOnly(['label', 'joinCode', 'linked', 'linkedAt'])
              && d.label is string && d.label.size() >= 1 && d.label.size() <= 20
              && validJoinCode(seatId)
              && d.joinCode == seatId
              && d.linked is bool
              && (!('linkedAt' in d) || d.linkedAt is number);
        }

        allow read: if isTeacherOf(classId);
        allow create: if isTeacherOf(classId)
                      && validSeat(request.resource.data)
                      && request.resource.data.linked == false
                      && !('linkedAt' in request.resource.data);
        allow update: if (isTeacherOf(classId)
                          && validSeat(request.resource.data)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label']))
                      // the join: any signed-in device, once, linked false -> true, nothing else changes
                      || (request.auth != null
                          && validSeat(request.resource.data)
                          && resource.data.linked == false
                          && request.resource.data.linked == true
                          && request.resource.data.linkedAt is number
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linked', 'linkedAt']));
        allow delete: if isTeacherOf(classId);
      }

      // The skill-state summary a linked device shares. Never: nickname, avatar, recovery code, answers.
      match /progress/{seatId} {
        function seatIsLinked() {
          return get(/databases/$(database)/documents/classes/$(classId)/seats/$(seatId)).data.linked == true;
        }

        function validSubjectProgress(s) {
          return s is map
              && s.keys().hasAll(['skills'])
              && s.keys().hasOnly(['level', 'missingCount', 'skills'])
              && s.skills is map
              && s.skills.size() <= 400
              && s.skills.values().hasOnly(['unknown', 'gap', 'learning', 'practised', 'mastered'])
              && (!('level' in s)
                  || (s.level is map
                      && s.level.keys().hasOnly(['grade', 'semester'])
                      && s.level.keys().hasAll(['grade', 'semester'])
                      && s.level.grade is int && s.level.grade >= 0 && s.level.grade <= 8
                      && s.level.semester in [1, 2]))
              && (!('missingCount' in s)
                  || (s.missingCount is int && s.missingCount >= 0 && s.missingCount <= 1000));
        }

        function validProgress(d) {
          return d.keys().hasAll(['subjects', 'playDaysThisWeek', 'updatedAt'])
              && d.keys().hasOnly(['subjects', 'playDaysThisWeek', 'updatedAt'])
              && d.subjects is map
              && d.subjects.keys().hasOnly(['mat', 'rom', 'stiinte', 'ist', 'geo', 'civ', 'logic', 'bio', 'fiz', 'chim'])
              && (!('mat' in d.subjects) || validSubjectProgress(d.subjects.mat))
              && (!('rom' in d.subjects) || validSubjectProgress(d.subjects.rom))
              && (!('stiinte' in d.subjects) || validSubjectProgress(d.subjects.stiinte))
              && (!('ist' in d.subjects) || validSubjectProgress(d.subjects.ist))
              && (!('geo' in d.subjects) || validSubjectProgress(d.subjects.geo))
              && (!('civ' in d.subjects) || validSubjectProgress(d.subjects.civ))
              && (!('logic' in d.subjects) || validSubjectProgress(d.subjects.logic))
              && (!('bio' in d.subjects) || validSubjectProgress(d.subjects.bio))
              && (!('fiz' in d.subjects) || validSubjectProgress(d.subjects.fiz))
              && (!('chim' in d.subjects) || validSubjectProgress(d.subjects.chim))
              && d.playDaysThisWeek is int && d.playDaysThisWeek >= 0 && d.playDaysThisWeek <= 7
              && d.updatedAt is number;
        }

        allow read: if isTeacherOf(classId);
        allow create, update: if request.auth != null
                              && validJoinCode(seatId)
                              && seatIsLinked()
                              && validProgress(request.resource.data);
        // the teacher clears it; a child can erase their own summary when leaving the class
        allow delete: if isTeacherOf(classId)
                      || (request.auth != null && exists(/databases/$(database)/documents/classes/$(classId)/seats/$(seatId)));
      }

      match /assignments/{assignmentId} {
        function validAssignment(d) {
          return d.keys().hasAll(['subject', 'skillIds', 'title', 'dueDay', 'createdAt'])
              && d.keys().hasOnly(['subject', 'skillIds', 'title', 'dueDay', 'createdAt'])
              && d.subject in ['mat', 'rom', 'stiinte', 'ist', 'geo', 'civ', 'logic', 'bio', 'fiz', 'chim']
              && d.skillIds is list && d.skillIds.size() >= 1 && d.skillIds.size() <= 10
              && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
              && d.dueDay is string && d.dueDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && d.createdAt is number;
        }

        // a linked device reads by classId (an unguessable id it got from the join); no personal data in here
        allow read: if request.auth != null;
        allow create, update: if isTeacherOf(classId) && validAssignment(request.resource.data);
        allow delete: if isTeacherOf(classId);
      }
    }

    // Index used to join: get by code only. No list, no update (a taken code makes the batch fail and a new code is drawn).
    match /joinCodes/{code} {
      allow get: if request.auth != null && validJoinCode(code);
      allow list: if false;
      allow create: if validJoinCode(code)
                    && request.resource.data.keys().hasAll(['classId', 'className'])
                    && request.resource.data.keys().hasOnly(['classId', 'className'])
                    && request.resource.data.classId is string
                    && request.resource.data.className is string
                    && request.resource.data.className.size() <= 60
                    && isTeacherOf(request.resource.data.classId);
      allow update: if false;
      allow delete: if resource == null || isTeacherOf(resource.data.classId);
    }
    // ===== END Classroom =====

    // ===== BEGIN Families (docs/PARENT_SYNC.md §3): parent account, synced children =====
    //
    // families/{uid}                  consent record of the parent (uid = Firebase Auth uid)
    // families/{uid}/children/{id}    one document per child: profile, progress, tombstone flag
    //
    // Only the parent themself, signed in with email + password (never an anonymous session), may read or
    // write anything under families/{uid}. Field allowlists on both documents; no recovery code, no class
    // link, no real names, no per-item answers can be stored. Known limits (rules cannot loop or measure
    // size): the entries of `skills`, `placements`, `levelHistory` and `missions` are not checked one by
    // one, and the ~900 KB cap on `progress` is enforced by the client (Firestore itself stops at 1 MiB);
    // the list sizes below bound the rest.

    function isFamilyOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'password';
    }

    match /families/{uid} {
      function validFamily(d) {
        return d.keys().hasAll(['consentAt', 'consentVersion', 'createdAt', 'updatedAt'])
            && d.keys().hasOnly(['consentAt', 'consentVersion', 'createdAt', 'updatedAt'])
            && d.consentAt is number
            && d.consentVersion is string && d.consentVersion.size() >= 1 && d.consentVersion.size() <= 32
            && d.createdAt is number
            && d.updatedAt is number;
      }

      allow read: if isFamilyOwner(uid);
      allow create: if isFamilyOwner(uid) && validFamily(request.resource.data);
      allow update: if isFamilyOwner(uid)
                    && validFamily(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isFamilyOwner(uid);

      match /children/{childId} {
        function validChildProfile(p) {
          return p is map
              && p.keys().hasAll(['id', 'nickname', 'avatar', 'grade', 'language', 'createdAt', 'updatedAt'])
              && p.keys().hasOnly(['id', 'nickname', 'avatar', 'grade', 'language', 'createdAt', 'updatedAt'])
              && p.id == childId
              && p.nickname is string && p.nickname.size() >= 1 && p.nickname.size() <= 20
              && p.avatar is string && p.avatar.size() >= 1 && p.avatar.size() <= 32
              && p.grade is int && p.grade >= 0 && p.grade <= 8
              && p.language in ['ro', 'en']
              && p.createdAt is number
              && p.updatedAt is number;
        }

        function validChildProgress(g) {
          return g is map
              && g.keys().hasAll(['profileId', 'skills', 'stars', 'stickers', 'playDays'])
              && g.keys().hasOnly(['profileId', 'skills', 'stars', 'stickers', 'playDays',
                                   'placements', 'levelHistory', 'missions'])
              && g.profileId == childId
              && g.skills is map && g.skills.size() <= 2000
              && g.stars is number && g.stars >= 0
              && g.stickers is list && g.stickers.size() <= 500
              && g.playDays is list && g.playDays.size() <= 1500
              && (!('placements' in g)
                  || (g.placements is map
                      && g.placements.keys().hasOnly(['mat', 'rom', 'stiinte', 'ist', 'geo', 'civ', 'logic', 'bio', 'fiz', 'chim'])))
              && (!('levelHistory' in g)
                  || (g.levelHistory is map
                      && g.levelHistory.keys().hasOnly(['mat', 'rom', 'stiinte', 'ist', 'geo', 'civ', 'logic', 'bio', 'fiz', 'chim'])))
              && (!('missions' in g) || (g.missions is list && g.missions.size() <= 14));
        }

        function validChild(d) {
          return d.keys().hasAll(['profile', 'progress', 'updatedAt', 'deviceId'])
              && d.keys().hasOnly(['profile', 'progress', 'updatedAt', 'deviceId', 'deleted'])
              && childId.matches('^[A-Za-z0-9_-]{1,64}$')
              && validChildProfile(d.profile)
              && validChildProgress(d.progress)
              && d.updatedAt is number
              && d.deviceId is string && d.deviceId.size() <= 64
              && (!('deleted' in d) || d.deleted is bool);
        }

        allow read: if isFamilyOwner(uid);
        allow create, update: if isFamilyOwner(uid) && validChild(request.resource.data);
        allow delete: if isFamilyOwner(uid);
      }
    }
    // ===== END Families =====
  }
}
