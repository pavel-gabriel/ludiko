rules_version = '2';

// Firestore rules for Ludiko — Phase 1c (Classroom / Teacher Mode)
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Game history: any authenticated user can create entries and read all history
    match /gameHistory/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Teacher profiles: teachers can read/write their own profile.
    // `list` is allowed for any authenticated user so the admin
    // dashboard can count teachers (get of individual docs stays owner-only).
    match /teachers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Classroom sessions: teachers can CRUD their own sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }

    // Session results: teachers can read/write results for their sessions
    match /sessionResults/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // Content reports ("Raportează o greșeală"). Anyone with an anonymous
    // session may create a report, but only with the allowed fields and
    // status 'open'. Reads and status updates are open to any authenticated
    // user because the admin dashboard is PIN-gated client-side (there is no
    // admin identity to check). Known limitation: an anonymous user can read
    // all reports and change their status. Deletes are denied.
    match /contentReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['itemId', 'skillId', 'reason', 'comment', 'createdAt', 'status', 'appVersion'])
                    && request.resource.data.keys().hasAll(
                         ['itemId', 'reason', 'createdAt', 'status'])
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() > 0
                    && request.resource.data.itemId.size() <= 100
                    && request.resource.data.reason in
                         ['wrong-answer', 'unclear', 'typo', 'inappropriate', 'rights']
                    && request.resource.data.createdAt is number
                    && request.resource.data.status == 'open'
                    && (!('skillId' in request.resource.data)
                        || (request.resource.data.skillId is string
                            && request.resource.data.skillId.size() <= 100))
                    && (!('comment' in request.resource.data)
                        || (request.resource.data.comment is string
                            && request.resource.data.comment.size() <= 300))
                    && (!('appVersion' in request.resource.data)
                        || (request.resource.data.appVersion is string
                            && request.resource.data.appVersion.size() <= 20));
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status in ['open', 'resolved', 'dismissed'];
    }

    // Templates: teachers can CRUD their own templates
    match /templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.teacherUid == request.auth.uid;
    }
  }
}
